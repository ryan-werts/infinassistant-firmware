@@ -19,6 +19,15 @@
  *      DEFINES
  *********************/
 
+/* get_glyph_dsc_id caches the last lookup (last_letter, last_glyph_id) in the font descriptor. A
+ * descriptor declared const is in flash, where the write is dropped, and on the nRF52832 the next
+ * read from the same 16-byte flash line can return a wrong value: the kerning pointer read right
+ * after the cache write came back non-NULL in a font with no kerning. Only a descriptor in RAM is
+ * written. */
+#ifndef LV_FONT_FMT_TXT_DSC_WRITABLE
+#define LV_FONT_FMT_TXT_DSC_WRITABLE(fdsc) ((lv_uintptr_t)(fdsc) >= 0x20000000u)
+#endif
+
 /**********************
  *      TYPEDEFS
  **********************/
@@ -244,13 +253,17 @@ static uint32_t get_glyph_dsc_id(const lv_font_t * font, uint32_t letter)
         }
 
         /*Update the cache*/
-        fdsc->last_letter = letter;
-        fdsc->last_glyph_id = glyph_id;
+        if(LV_FONT_FMT_TXT_DSC_WRITABLE(fdsc)) {
+            fdsc->last_letter = letter;
+            fdsc->last_glyph_id = glyph_id;
+        }
         return glyph_id;
     }
 
-    fdsc->last_letter = letter;
-    fdsc->last_glyph_id = 0;
+    if(LV_FONT_FMT_TXT_DSC_WRITABLE(fdsc)) {
+        fdsc->last_letter = letter;
+        fdsc->last_glyph_id = 0;
+    }
     return 0;
 
 }
