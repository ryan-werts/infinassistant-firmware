+/**
+ * Check a text or value font that a style lookup resolved, before it is used. This default
+ * accepts every font; an application can define its own (the InfiniTime HA overlay does, in
+ * ha_bridge/BootBox.cpp) to catch a pointer that is not a font and return a usable one.
+ * @param font the font the lookup resolved
+ * @param obj the object whose style was looked up
+ * @param part the part that was looked up
+ * @return the font to use
+ */
+__attribute__((weak)) const void * lv_font_guard(const void * font, const lv_obj_t * obj, uint8_t part)
+{
+    (void)obj;
+    (void)part;
+    return font;
+}
+
+const void * _lv_obj_get_style_ptr(const lv_obj_t * obj, uint8_t part, lv_style_property_t prop)
+{
+    const void * value = get_style_ptr_unguarded(obj, part, prop);
+    lv_style_property_t base = prop & (~LV_STYLE_STATE_MASK);
+    if(base == LV_STYLE_TEXT_FONT || base == LV_STYLE_VALUE_FONT) {
+        value = lv_font_guard(value, obj, part);
+    }
+    return value;
+}
+
