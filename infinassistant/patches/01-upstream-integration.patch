+namespace {
+  lv_obj_t* bootBoxLabel = nullptr;
+  TickType_t bootBoxUpdatedAt = 0;
+
+  void BootBoxShow() {
+    HaBootBoxPhase(1);
+    const char* report = HaBootBoxReport();
+    HaBootBoxPhase(0);
+    if (report == nullptr) {
+      return;
+    }
+    bootBoxLabel = lv_label_create(lv_layer_top(), nullptr);
+    lv_label_set_long_mode(bootBoxLabel, LV_LABEL_LONG_BREAK);
+    lv_obj_set_width(bootBoxLabel, LV_HOR_RES);
+    lv_obj_set_style_local_bg_color(bootBoxLabel, LV_LABEL_PART_MAIN, LV_STATE_DEFAULT, LV_COLOR_BLACK);
+    lv_obj_set_style_local_bg_opa(bootBoxLabel, LV_LABEL_PART_MAIN, LV_STATE_DEFAULT, LV_OPA_COVER);
+    lv_obj_set_style_local_text_color(bootBoxLabel, LV_LABEL_PART_MAIN, LV_STATE_DEFAULT, LV_COLOR_WHITE);
+    lv_label_set_text_static(bootBoxLabel, report);
+    lv_obj_set_pos(bootBoxLabel, 0, 0);
+    // Drawn now rather than at the first refresh, so a boot that dies while the watch face is
+    // built still shows the previous boot's record.
+    lv_refr_now(nullptr);
+    bootBoxUpdatedAt = xTaskGetTickCount();
+  }
+
+  void BootBoxRefresh() {
+    HaBootBoxDisplayTick();
+    if (bootBoxLabel == nullptr) {
+      return;
+    }
+    const TickType_t now = xTaskGetTickCount();
+    if (now - bootBoxUpdatedAt < configTICK_RATE_HZ) {
+      return;
+    }
+    bootBoxUpdatedAt = now;
+    if (now >= 60 * configTICK_RATE_HZ) {
+      lv_obj_del(bootBoxLabel);
+      bootBoxLabel = nullptr;
+      HaBootBoxReportDone();
+      return;
+    }
+    HaBootBoxPhase(1);
+    lv_label_set_text_static(bootBoxLabel, HaBootBoxReport());
+    HaBootBoxPhase(0);
+  }
+}
+#endif
 
