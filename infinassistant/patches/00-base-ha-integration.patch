+bool HaAction::DecodeCbor(const uint8_t* data, size_t len, HaAction& out) {
+  CborParser parser;
+  CborValue value, mapValue;
+
+  if (cbor_parser_init(data, len, 0, &parser, &value) != CborNoError) return false;
+  if (!cbor_value_is_map(&value)) return false;
+
+  if (cbor_value_enter_container(&value, &mapValue) != CborNoError) return false;
+
+  while (!cbor_value_at_end(&mapValue)) {
+    std::string key;
+    if (!DecodeString(&mapValue, key)) return false;
+
+    if (key == "actionId") {
+      uint64_t id;
+      if (cbor_value_get_uint64(&mapValue, &id) != CborNoError) return false;
+      out.actionId = static_cast<uint8_t>(id);
+      cbor_value_advance(&mapValue);
+    } else if (key == "label") {
+      if (!DecodeString(&mapValue, out.label)) return false;
+    } else if (key == "entityId") {
+      if (!DecodeString(&mapValue, out.entityId)) return false;
+    } else if (key == "serviceAction") {
+      if (!DecodeString(&mapValue, out.serviceAction)) return false;
+    } else if (key == "serviceData") {
+      if (!cbor_value_is_map(&mapValue)) return false;
+      CborValue dataMap;
+      if (cbor_value_enter_container(&mapValue, &dataMap) != CborNoError) return false;
+      while (!cbor_value_at_end(&dataMap)) {
+        std::string k, v;
+        if (!DecodeString(&dataMap, k)) return false;
+        if (!DecodeString(&dataMap, v)) return false;
+        out.serviceData.push_back({k, v});
+      }
+      cbor_value_leave_container(&mapValue, &dataMap);
+    } else {
+      cbor_value_advance(&mapValue);
+    }
+  }
+
+  cbor_value_leave_container(&value, &mapValue);
+  return true;
+}
