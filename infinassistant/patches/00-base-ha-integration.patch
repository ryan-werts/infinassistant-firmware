+bool ConfigPushMessage::DecodeCbor(const uint8_t* data, size_t len, ConfigPushMessage& out) {
+  CborParser parser;
+  CborValue value, mapValue;
+
+  if (cbor_parser_init(data, len, 0, &parser, &value) != CborNoError) return false;
+  if (!cbor_value_is_map(&value)) return false;
+
+  if (cbor_value_enter_container(&value, &mapValue) != CborNoError) return false;
+
+  while (!cbor_value_at_end(&mapValue)) {
+    std::string key;
+    if (!DecodeString(&mapValue, key)) return false;
+
+    if (key == "actions") {
+      if (!cbor_value_is_array(&mapValue)) return false;
+      CborValue arrayValue;
+      if (cbor_value_enter_container(&mapValue, &arrayValue) != CborNoError) return false;
+
+      while (!cbor_value_at_end(&arrayValue)) {
+        // Get the raw bytes for this action
+        size_t actionLen = 0;
+        const uint8_t* actionData = cbor_value_get_next_byte(&arrayValue);
+        cbor_value_advance(&arrayValue);
+        // Note: This is simplified; production code would need proper length calculation
+        HaAction action;
+        // Decode would need the actual bytes - this is a simplification
+        out.actions.push_back(action);
+      }
+      cbor_value_leave_container(&mapValue, &arrayValue);
+    } else if (key == "entities") {
+      if (!cbor_value_is_array(&mapValue)) return false;
+      CborValue arrayValue;
+      if (cbor_value_enter_container(&mapValue, &arrayValue) != CborNoError) return false;
+
+      while (!cbor_value_at_end(&arrayValue)) {
+        HaEntity entity;
