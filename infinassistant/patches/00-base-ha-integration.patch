+++ b/src/ha_bridge/BridgeController.h
@@ -0,0 +1,60 @@
+#pragma once
+
+#include "../components/ble/HomeAssistantService.h"
+#include "../displayapp/apps/HomeAssistantApp.h"
+#include "FrameCodec.h"
+#include "ProtocolMessages.h"
+#include <memory>
+#include <vector>
+
+namespace Pinetime {
+namespace Applications {
+namespace HaBridge {
+
+/**
+ * BridgeController ties together the BLE service, protocol layer, and UI app.
+ * It handles the bidirectional data flow:
+ * - BLE → Frame decoding → CBOR decoding → UI updates
+ * - UI actions → CBOR encoding → Frame encoding → BLE
+ */
+class BridgeController {
+ public:
+  BridgeController();
+  ~BridgeController();
+
+  // Initialize all components
+  void Init();
+
+  // Periodic tick for maintenance (reassembly timeouts, etc.)
+  void OnTick();
+
+  // Get the UI app instance (for integration into InfiniTime's app list)
+  HomeAssistantApp* GetApp() { return app_.get(); }
+
+ private:
+  // BLE service
+  std::unique_ptr<Pinetime::Components::HomeAssistantService> bleService_;
+
+  // Frame codec for chunking/reassembly
+  FrameCodec frameCodec_;
+
+  // UI app
+  std::unique_ptr<HomeAssistantApp> app_;
+
+  // Handlers
+  void OnBleDataReceived(const std::vector<uint8_t>& data);
+  void OnFrameReceived(const Frame& frame);
+  void OnUIActionInvoked(uint8_t actionId, const char* gesture);
+
+  // Message handlers
+  void HandleConfigPush(const std::vector<uint8_t>& payload);
+  void HandleStateUpdate(const std::vector<uint8_t>& payload);
+  void HandleNotifPush(const std::vector<uint8_t>& payload);
+
+  // Send message to phone
+  void SendMessage(MessageType type, const std::vector<uint8_t>& payload);
+};
+
+} // namespace HaBridge
+} // namespace Applications
+} // namespace Pinetime
diff --git a/src/ha_bridge/FrameCodec.cpp b/src/ha_bridge/FrameCodec.cpp
new file mode 100755
index 00000000..2717928e
--- /dev/null
+++ b/src/ha_bridge/FrameCodec.cpp
@@ -0,0 +1,153 @@
+#include "FrameCodec.h"
+
+#include <algorithm>
+#include <cstring>
+
+namespace Pinetime {
+namespace Applications {
+namespace HaBridge {
+
+static constexpr size_t kHeaderLen = 9;
+
+static uint16_t ReadU16Le(const uint8_t* p) {
+  return static_cast<uint16_t>(p[0] | (p[1] << 8));
+}
+
+static void WriteU16Le(uint8_t* p, uint16_t v) {
+  p[0] = static_cast<uint8_t>(v & 0xFF);
+  p[1] = static_cast<uint8_t>((v >> 8) & 0xFF);
+}
+
+std::optional<Frame> Reassembler::Ingest(const std::vector<uint8_t>& frame, uint32_t nowMs) {
+  // Purge timeouts.
+  for (auto it = inFlight_.begin(); it != inFlight_.end();) {
+    if (nowMs - it->second.firstSeenMs > timeoutMs_) {
+      it = inFlight_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+
+  if (frame.size() < kHeaderLen) {
+    return std::nullopt;
+  }
+
+  FrameHeader h{};
+  h.version = frame[0];
+  h.type = frame[1];
+  h.flags = frame[2];
+  h.msgId = ReadU16Le(&frame[3]);
+  h.totalLen = ReadU16Le(&frame[5]);
+  h.chunkIndex = frame[7];
+  h.chunkCount = frame[8];
+
+  if (h.chunkCount == 0 || h.chunkIndex >= h.chunkCount) {
+    return std::nullopt;
+  }
+
+  auto& inflight = inFlight_[h.msgId];
+  if (inflight.chunks.empty()) {
+    inflight.header = h;
+    inflight.firstSeenMs = nowMs;
+    inflight.chunks.resize(h.chunkCount);
+    inflight.received = 0;
+  }
+
+  // If message meta differs, reset.
+  if (inflight.header.totalLen != h.totalLen || inflight.header.chunkCount != h.chunkCount || inflight.header.type != h.type) {
+    inflight.header = h;
+    inflight.firstSeenMs = nowMs;
+    inflight.chunks.assign(h.chunkCount, {});
+    inflight.received = 0;
+  }
+
+  const auto chunkBytesBegin = frame.begin() + static_cast<long>(kHeaderLen);
+  std::vector<uint8_t> chunk(chunkBytesBegin, frame.end());
+
+  if (inflight.chunks[h.chunkIndex].empty()) {
+    inflight.chunks[h.chunkIndex] = std::move(chunk);
+    inflight.received++;
+  } else {
+    inflight.chunks[h.chunkIndex] = std::move(chunk);
+  }
+
+  if (inflight.received < h.chunkCount) {
+    return std::nullopt;
+  }
+
+  std::vector<uint8_t> payload;
+  payload.reserve(h.totalLen);
+  for (uint8_t i = 0; i < h.chunkCount; i++) {
+    const auto& c = inflight.chunks[i];
+    payload.insert(payload.end(), c.begin(), c.end());
+  }
+  if (payload.size() > h.totalLen) {
+    payload.resize(h.totalLen);
+  }
+  if (payload.size() != h.totalLen) {
+    inFlight_.erase(h.msgId);
+    return std::nullopt;
+  }
+
+  Frame out{h, std::move(payload)};
+  inFlight_.erase(h.msgId);
+  return out;
+}
+
+void Reassembler::Clear() {
+  inFlight_.clear();
+}
+
+std::vector<std::vector<uint8_t>> Chunk(uint8_t version,
+                                       uint8_t type,
+                                       uint8_t flags,
+                                       uint16_t msgId,
+                                       const std::vector<uint8_t>& payload,
+                                       uint16_t maxFrameBytes) {
+  const uint16_t maxChunk = (maxFrameBytes > kHeaderLen) ? (maxFrameBytes - kHeaderLen) : 1;
+  const uint16_t chunkCount = static_cast<uint16_t>((payload.size() + maxChunk - 1) / maxChunk);
+
+  std::vector<std::vector<uint8_t>> frames;
+  frames.reserve(chunkCount);
+
+  for (uint16_t i = 0; i < chunkCount; i++) {
+    const size_t start = static_cast<size_t>(i) * maxChunk;
+    const size_t end = std::min(payload.size(), start + maxChunk);
+
+    std::vector<uint8_t> frame;
+    frame.resize(kHeaderLen + (end - start));
+
+    frame[0] = version;
+    frame[1] = type;
+    frame[2] = flags;
+    WriteU16Le(&frame[3], msgId);
+    WriteU16Le(&frame[5], static_cast<uint16_t>(payload.size()));
+    frame[7] = static_cast<uint8_t>(i);
+    frame[8] = static_cast<uint8_t>(chunkCount);
+
+    if (end > start) {
+      std::memcpy(&frame[kHeaderLen], payload.data() + start, end - start);
+    }
+    frames.push_back(std::move(frame));
+  }
+
+  return frames;
+}
+
+void FrameCodec::OnDataReceived(const std::vector<uint8_t>& data, uint32_t nowMs,
+                                std::function<void(const Frame&)> onFrameReady) {
+  auto result = reassembler_.Ingest(data, nowMs);
+  if (result.has_value() && onFrameReady) {
+    onFrameReady(result.value());
+  }
+}
+
+std::vector<std::vector<uint8_t>> FrameCodec::EncodeMessage(uint8_t type,
+                                                            const std::vector<uint8_t>& payload) {
+  uint16_t msgId = nextMsgId_++;
+  return Chunk(0x01, type, 0x00, msgId, payload, mtuSize_);
+}
+
+} // namespace HaBridge
+} // namespace Applications
+} // namespace Pinetime
diff --git a/src/ha_bridge/FrameCodec.h b/src/ha_bridge/FrameCodec.h
new file mode 100755
index 00000000..6ed2119a
--- /dev/null
+++ b/src/ha_bridge/FrameCodec.h
@@ -0,0 +1,85 @@
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <unordered_map>
+#include <vector>
+
+namespace Pinetime {
+namespace Applications {
+namespace HaBridge {
+
+struct FrameHeader {
+  uint8_t version;
+  uint8_t type;
+  uint8_t flags;
+  uint16_t msgId;
+  uint16_t totalLen;
+  uint8_t chunkIndex;
+  uint8_t chunkCount;
+};
+
+// Alias for a complete reassembled frame
+struct Frame {
+  FrameHeader header;
+  std::vector<uint8_t> payload;
+};
+
+class Reassembler {
+ public:
+  explicit Reassembler(uint32_t timeoutMs = 5000) : timeoutMs_(timeoutMs) {}
+
+  // Feed a single BLE frame (header+chunk). Returns a complete frame when all chunks arrive.
+  std::optional<Frame> Ingest(const std::vector<uint8_t>& frame, uint32_t nowMs);
+
+  void Clear();
+
+ private:
+  struct InFlight {
+    FrameHeader header;
+    uint32_t firstSeenMs;
+    std::vector<std::vector<uint8_t>> chunks;
+    uint32_t received{0};
+  };
+
+  uint32_t timeoutMs_;
+  std::unordered_map<uint16_t, InFlight> inFlight_;
+};
+
+// Encode a payload into chunked frames, given maximum frame size (ATT payload). Header is 9 bytes.
+std::vector<std::vector<uint8_t>> Chunk(uint8_t version,
+                                       uint8_t type,
+                                       uint8_t flags,
+                                       uint16_t msgId,
+                                       const std::vector<uint8_t>& payload,
+                                       uint16_t maxFrameBytes);
+
+/**
+ * FrameCodec wraps the Reassembler for incoming frames and provides
+ * chunking for outgoing frames.
+ */
+class FrameCodec {
+ public:
+  explicit FrameCodec(uint16_t mtuSize = 247) : mtuSize_(mtuSize) {}
+
+  // Process incoming BLE data. Calls callback when a complete frame is ready.
+  void OnDataReceived(const std::vector<uint8_t>& data, uint32_t nowMs,
+                     std::function<void(const Frame&)> onFrameReady);
+
+  // Encode a message into BLE frames ready to send
+  std::vector<std::vector<uint8_t>> EncodeMessage(uint8_t type,
+                                                  const std::vector<uint8_t>& payload);
+
+  void SetMtu(uint16_t mtu) { mtuSize_ = mtu; }
+  void Clear() { reassembler_.Clear(); }
+
+ private:
+  Reassembler reassembler_;
+  uint16_t mtuSize_;
+  uint16_t nextMsgId_{0};
+};
+
+} // namespace HaBridge
+} // namespace Applications
+} // namespace Pinetime
diff --git a/src/ha_bridge/ProtocolMessages.cpp b/src/ha_bridge/ProtocolMessages.cpp
new file mode 100755
index 00000000..0684bdbd
--- /dev/null
+++ b/src/ha_bridge/ProtocolMessages.cpp
@@ -0,0 +1,534 @@
+#include "ProtocolMessages.h"
+#include <cbor.h>
+#include <cstring>
+
+namespace Pinetime {
+namespace Applications {
+namespace HaBridge {
+
+// Helper to encode string to CBOR
+static bool EncodeString(CborEncoder* encoder, const std::string& str) {
+  return cbor_encode_text_stringz(encoder, str.c_str()) == CborNoError;
+}
+
+// Helper to decode string from CBOR
+static bool DecodeString(CborValue* value, std::string& out) {
+  if (!cbor_value_is_text_string(value)) return false;
+
+  size_t len = 0;
+  if (cbor_value_calculate_string_length(value, &len) != CborNoError) return false;
+
+  std::vector<char> buffer(len + 1);
+  if (cbor_value_copy_text_string(value, buffer.data(), &len, value) != CborNoError) return false;
+
+  buffer[len] = '\0';
+  out = std::string(buffer.data());
+  return true;
+}
+
+// HaAction encoding/decoding
+bool HaAction::EncodeCbor(std::vector<uint8_t>& output) const {
+  uint8_t buffer[512];
+  CborEncoder encoder, mapEncoder;
+  cbor_encoder_init(&encoder, buffer, sizeof(buffer), 0);
+
+  if (cbor_encoder_create_map(&encoder, &mapEncoder, 5) != CborNoError) return false;
+
+  // actionId
+  if (cbor_encode_text_stringz(&mapEncoder, "actionId") != CborNoError) return false;
+  if (cbor_encode_uint(&mapEncoder, actionId) != CborNoError) return false;
+
+  // label
+  if (cbor_encode_text_stringz(&mapEncoder, "label") != CborNoError) return false;
+  if (!EncodeString(&mapEncoder, label)) return false;
+
+  // entityId
+  if (cbor_encode_text_stringz(&mapEncoder, "entityId") != CborNoError) return false;
+  if (!EncodeString(&mapEncoder, entityId)) return false;
+
+  // serviceAction
+  if (cbor_encode_text_stringz(&mapEncoder, "serviceAction") != CborNoError) return false;
+  if (!EncodeString(&mapEncoder, serviceAction)) return false;
+
+  // serviceData (optional map)
+  if (cbor_encode_text_stringz(&mapEncoder, "serviceData") != CborNoError) return false;
+  CborEncoder dataMapEncoder;
+  if (cbor_encoder_create_map(&mapEncoder, &dataMapEncoder, serviceData.size()) != CborNoError) return false;
+  for (const auto& [key, value] : serviceData) {
+    if (!EncodeString(&dataMapEncoder, key)) return false;
+    if (!EncodeString(&dataMapEncoder, value)) return false;
+  }
+  if (cbor_encoder_close_container(&mapEncoder, &dataMapEncoder) != CborNoError) return false;
+
+  if (cbor_encoder_close_container(&encoder, &mapEncoder) != CborNoError) return false;
+
+  size_t len = cbor_encoder_get_buffer_size(&encoder, buffer);
