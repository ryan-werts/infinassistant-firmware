+// CONFIG_PUSH message (phone → watch)
+struct ConfigPushMessage : public ProtocolMessage {
+  std::vector<HaAction> actions;
+  std::vector<HaEntity> entities;
+
+  MessageType GetType() const override { return MessageType::CONFIG_PUSH; }
+  bool EncodeCbor(std::vector<uint8_t>& output) const override;
+  static bool DecodeCbor(const uint8_t* data, size_t len, ConfigPushMessage& out);
+};
