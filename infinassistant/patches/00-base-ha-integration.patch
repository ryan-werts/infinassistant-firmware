+// ConfigPushMessage encoding/decoding
+bool ConfigPushMessage::EncodeCbor(std::vector<uint8_t>& output) const {
+  uint8_t buffer[2048];
+  CborEncoder encoder, mapEncoder;
+  cbor_encoder_init(&encoder, buffer, sizeof(buffer), 0);
+
+  if (cbor_encoder_create_map(&encoder, &mapEncoder, 2) != CborNoError) return false;
+
+  // actions array
+  if (cbor_encode_text_stringz(&mapEncoder, "actions") != CborNoError) return false;
+  CborEncoder actionsArray;
+  if (cbor_encoder_create_array(&mapEncoder, &actionsArray, actions.size()) != CborNoError) return false;
+  for (const auto& action : actions) {
+    std::vector<uint8_t> actionData;
+    if (!action.EncodeCbor(actionData)) return false;
+    // Parse and re-encode to embed in array
+    CborParser p;
+    CborValue v;
+    cbor_parser_init(actionData.data(), actionData.size(), 0, &p, &v);
+    if (cbor_encoder_copy_value(&actionsArray, &v) != CborNoError) return false;
+  }
+  if (cbor_encoder_close_container(&mapEncoder, &actionsArray) != CborNoError) return false;
+
+  // entities array
+  if (cbor_encode_text_stringz(&mapEncoder, "entities") != CborNoError) return false;
+  CborEncoder entitiesArray;
+  if (cbor_encoder_create_array(&mapEncoder, &entitiesArray, entities.size()) != CborNoError) return false;
+  for (const auto& entity : entities) {
+    std::vector<uint8_t> entityData;
+    if (!entity.EncodeCbor(entityData)) return false;
+    CborParser p;
+    CborValue v;
+    cbor_parser_init(entityData.data(), entityData.size(), 0, &p, &v);
+    if (cbor_encoder_copy_value(&entitiesArray, &v) != CborNoError) return false;
+  }
+  if (cbor_encoder_close_container(&mapEncoder, &entitiesArray) != CborNoError) return false;
+
+  if (cbor_encoder_close_container(&encoder, &mapEncoder) != CborNoError) return false;
+
+  size_t len = cbor_encoder_get_buffer_size(&encoder, buffer);
+  output.insert(output.end(), buffer, buffer + len);
+  return true;
+}
