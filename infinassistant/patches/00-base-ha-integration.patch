diff --git a/src/displayapp/screens/HomeAssistant.cpp b/src/displayapp/screens/HomeAssistant.cpp
new file mode 100755
index 00000000..2fcdf968
--- /dev/null
+++ b/src/displayapp/screens/HomeAssistant.cpp
@@ -0,0 +1,236 @@
+#include "displayapp/screens/HomeAssistant.h"
+#include "displayapp/DisplayApp.h"
+
+using namespace Pinetime::Applications::Screens;
+
+namespace {
+  constexpr int TAB_HEIGHT = 40;
+  constexpr int CONTENT_Y = TAB_HEIGHT + 5;
+  constexpr int SCREEN_WIDTH = 240;
+  constexpr int SCREEN_HEIGHT = 240;
+}
+
+HomeAssistant::HomeAssistant(Controllers::HomeAssistantService& haService)
+    : Screen(), haService_(haService) {
+  CreateUI();
+  taskRefresh_ = lv_task_create([](lv_task_t* task) {
+    auto* screen = static_cast<HomeAssistant*>(task->user_data);
+    screen->Refresh();
+  }, LV_DISP_DEF_REFR_PERIOD, LV_TASK_PRIO_MID, this);
+}
+
+HomeAssistant::~HomeAssistant() {
+  if (taskRefresh_ != nullptr) {
+    lv_task_del(taskRefresh_);
+  }
+  if (container_ != nullptr) {
+    lv_obj_del(container_);
+  }
+}
+
+void HomeAssistant::Refresh() {
+  if (haService_.HasUpdate()) {
+    haService_.ClearUpdate();
+    SwitchTab(currentTab_);  // Rebuild current tab with new data
+  }
+}
+
+void HomeAssistant::CreateUI() {
+  container_ = lv_obj_create(lv_scr_act(), nullptr);
+  lv_obj_set_size(container_, SCREEN_WIDTH, SCREEN_HEIGHT);
+  lv_obj_set_pos(container_, 0, 0);
+  lv_obj_set_style_local_bg_color(container_, LV_OBJ_PART_MAIN, LV_STATE_DEFAULT, LV_COLOR_BLACK);
+  lv_obj_set_style_local_border_width(container_, LV_OBJ_PART_MAIN, LV_STATE_DEFAULT, 0);
+  lv_obj_set_style_local_pad_all(container_, LV_OBJ_PART_MAIN, LV_STATE_DEFAULT, 0);
+
+  const char* tabNames[] = {"Actions", "States", "Inbox"};
+  int tabWidth = SCREEN_WIDTH / 3;
+
+  for (int i = 0; i < 3; i++) {
+    tabButtons_[i] = lv_btn_create(container_, nullptr);
+    lv_obj_set_size(tabButtons_[i], tabWidth, TAB_HEIGHT);
+    lv_obj_set_pos(tabButtons_[i], i * tabWidth, 0);
+    lv_obj_set_style_local_radius(tabButtons_[i], LV_BTN_PART_MAIN, LV_STATE_DEFAULT, 0);
+    lv_obj_set_style_local_border_width(tabButtons_[i], LV_BTN_PART_MAIN, LV_STATE_DEFAULT, 1);
+    lv_obj_set_style_local_border_color(tabButtons_[i], LV_BTN_PART_MAIN, LV_STATE_DEFAULT, LV_COLOR_GRAY);
+    lv_obj_set_user_data(tabButtons_[i], this);
+    lv_obj_set_event_cb(tabButtons_[i], OnTabClicked);
+
+    tabLabels_[i] = lv_label_create(tabButtons_[i], nullptr);
+    lv_label_set_text(tabLabels_[i], tabNames[i]);
+    lv_obj_align(tabLabels_[i], nullptr, LV_ALIGN_CENTER, 0, 0);
+  }
+
+  contentArea_ = lv_obj_create(container_, nullptr);
+  lv_obj_set_size(contentArea_, SCREEN_WIDTH, SCREEN_HEIGHT - CONTENT_Y);
+  lv_obj_set_pos(contentArea_, 0, CONTENT_Y);
+  lv_obj_set_style_local_bg_color(contentArea_, LV_OBJ_PART_MAIN, LV_STATE_DEFAULT, LV_COLOR_BLACK);
+  lv_obj_set_style_local_border_width(contentArea_, LV_OBJ_PART_MAIN, LV_STATE_DEFAULT, 0);
+
+  SwitchTab(Tab::Actions);
+}
+
+void HomeAssistant::SwitchTab(Tab tab) {
+  currentTab_ = tab;
+
+  for (int i = 0; i < 3; i++) {
+    bool isActive = (i == static_cast<int>(tab));
+    lv_obj_set_style_local_bg_color(tabButtons_[i], LV_BTN_PART_MAIN, LV_STATE_DEFAULT,
+                                    isActive ? LV_COLOR_MAKE(0x00, 0x60, 0xA0) : LV_COLOR_MAKE(0x30, 0x30, 0x30));
+  }
+
+  ClearContent();
+
+  switch (tab) {
+    case Tab::Actions:
+      ShowActionsTab();
+      break;
+    case Tab::States:
+      ShowStatesTab();
+      break;
+    case Tab::Inbox:
+      ShowInboxTab();
+      break;
+  }
+}
+
+void HomeAssistant::ClearContent() {
+  lv_obj_clean(contentArea_);
+}
+
+void HomeAssistant::ShowActionsTab() {
+  const auto& actions = haService_.GetActions();
+
+  if (actions.empty()) {
+    lv_obj_t* label = lv_label_create(contentArea_, nullptr);
+    lv_label_set_text(label, "No actions\nConnect phone app");
+    lv_obj_set_style_local_text_color(label, LV_LABEL_PART_MAIN, LV_STATE_DEFAULT, LV_COLOR_GRAY);
+    lv_obj_align(label, nullptr, LV_ALIGN_CENTER, 0, 0);
+    return;
+  }
+
+  int btnHeight = 45;
+  int btnWidth = SCREEN_WIDTH - 20;
+  int y = 5;
+
+  for (size_t i = 0; i < actions.size() && i < 4; i++) {
+    lv_obj_t* btn = lv_btn_create(contentArea_, nullptr);
+    lv_obj_set_size(btn, btnWidth, btnHeight);
+    lv_obj_set_pos(btn, 10, y);
+    lv_obj_set_style_local_bg_color(btn, LV_BTN_PART_MAIN, LV_STATE_DEFAULT, LV_COLOR_MAKE(0x20, 0x40, 0x60));
+    lv_obj_set_style_local_radius(btn, LV_BTN_PART_MAIN, LV_STATE_DEFAULT, 8);
+    lv_obj_set_user_data(btn, this);
+    lv_obj_set_event_cb(btn, OnActionClicked);
+
+    lv_obj_t* label = lv_label_create(btn, nullptr);
+    lv_label_set_text(label, actions[i].label.data());
+    lv_obj_align(label, nullptr, LV_ALIGN_CENTER, 0, 0);
+
+    y += btnHeight + 5;
+  }
+}
+
+void HomeAssistant::ShowStatesTab() {
+  const auto& entities = haService_.GetEntities();
+
+  if (entities.empty()) {
+    lv_obj_t* label = lv_label_create(contentArea_, nullptr);
+    lv_label_set_text(label, "No entities\nConnect phone app");
+    lv_obj_set_style_local_text_color(label, LV_LABEL_PART_MAIN, LV_STATE_DEFAULT, LV_COLOR_GRAY);
+    lv_obj_align(label, nullptr, LV_ALIGN_CENTER, 0, 0);
+    return;
+  }
+
+  int rowHeight = 50;
+  int y = 10;
+
+  for (size_t i = 0; i < entities.size() && i < 3; i++) {
+    lv_obj_t* nameLabel = lv_label_create(contentArea_, nullptr);
+    lv_label_set_text(nameLabel, entities[i].name.data());
+    lv_obj_set_style_local_text_color(nameLabel, LV_LABEL_PART_MAIN, LV_STATE_DEFAULT, LV_COLOR_WHITE);
+    lv_obj_set_pos(nameLabel, 15, y);
+
+    char stateBuf[48];
+    snprintf(stateBuf, sizeof(stateBuf), "%s %s", entities[i].state.data(), entities[i].unit.data());
+    lv_obj_t* valueLabel = lv_label_create(contentArea_, nullptr);
+    lv_label_set_text(valueLabel, stateBuf);
+    lv_obj_set_style_local_text_color(valueLabel, LV_LABEL_PART_MAIN, LV_STATE_DEFAULT, LV_COLOR_CYAN);
+    lv_obj_set_pos(valueLabel, 15, y + 20);
+
+    lv_obj_t* line = lv_obj_create(contentArea_, nullptr);
+    lv_obj_set_size(line, SCREEN_WIDTH - 30, 1);
+    lv_obj_set_pos(line, 15, y + 45);
+    lv_obj_set_style_local_bg_color(line, LV_OBJ_PART_MAIN, LV_STATE_DEFAULT, LV_COLOR_MAKE(0x40, 0x40, 0x40));
+
+    y += rowHeight + 5;
+  }
+}
+
+void HomeAssistant::ShowInboxTab() {
+  const auto& notifications = haService_.GetNotifications();
+
+  if (notifications.empty()) {
+    lv_obj_t* label = lv_label_create(contentArea_, nullptr);
+    lv_label_set_text(label, "No notifications");
+    lv_obj_set_style_local_text_color(label, LV_LABEL_PART_MAIN, LV_STATE_DEFAULT, LV_COLOR_GRAY);
+    lv_obj_align(label, nullptr, LV_ALIGN_CENTER, 0, 0);
+    return;
+  }
+
+  int cardHeight = 70;
+  int y = 5;
+
+  for (size_t i = 0; i < notifications.size() && i < 2; i++) {
+    lv_obj_t* card = lv_obj_create(contentArea_, nullptr);
+    lv_obj_set_size(card, SCREEN_WIDTH - 20, cardHeight);
+    lv_obj_set_pos(card, 10, y);
+    lv_obj_set_style_local_bg_color(card, LV_OBJ_PART_MAIN, LV_STATE_DEFAULT, LV_COLOR_MAKE(0x25, 0x25, 0x35));
+    lv_obj_set_style_local_radius(card, LV_OBJ_PART_MAIN, LV_STATE_DEFAULT, 8);
+    lv_obj_set_style_local_border_width(card, LV_OBJ_PART_MAIN, LV_STATE_DEFAULT, 0);
+
+    lv_obj_t* titleLabel = lv_label_create(card, nullptr);
+    lv_label_set_text(titleLabel, notifications[i].title.data());
+    lv_obj_set_style_local_text_color(titleLabel, LV_LABEL_PART_MAIN, LV_STATE_DEFAULT, LV_COLOR_YELLOW);
+    lv_obj_set_pos(titleLabel, 10, 10);
+
+    lv_obj_t* bodyLabel = lv_label_create(card, nullptr);
+    lv_label_set_text(bodyLabel, notifications[i].body.data());
+    lv_obj_set_style_local_text_color(bodyLabel, LV_LABEL_PART_MAIN, LV_STATE_DEFAULT, LV_COLOR_WHITE);
+    lv_obj_set_pos(bodyLabel, 10, 35);
+
+    y += cardHeight + 10;
+  }
+}
+
+bool HomeAssistant::OnTouchEvent(TouchEvents event) {
+  if (event == TouchEvents::SwipeLeft) {
+    int next = (static_cast<int>(currentTab_) + 1) % 3;
+    SwitchTab(static_cast<Tab>(next));
+    return true;
+  }
+  if (event == TouchEvents::SwipeRight) {
+    int prev = (static_cast<int>(currentTab_) + 2) % 3;
+    SwitchTab(static_cast<Tab>(prev));
+    return true;
+  }
+  return false;
+}
+
+void HomeAssistant::OnTabClicked(lv_obj_t* obj, lv_event_t event) {
+  if (event != LV_EVENT_CLICKED) return;
+
+  auto* screen = static_cast<HomeAssistant*>(lv_obj_get_user_data(obj));
+  if (!screen) return;
+
+  for (int i = 0; i < 3; i++) {
+    if (screen->tabButtons_[i] == obj) {
+      screen->SwitchTab(static_cast<Tab>(i));
+      break;
+    }
+  }
+}
+
+void HomeAssistant::OnActionClicked(lv_obj_t* /*obj*/, lv_event_t event) {
+  if (event != LV_EVENT_CLICKED) return;
+  // TODO: Send action trigger to phone via BLE
+}
