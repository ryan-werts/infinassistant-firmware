diff --git a/src/ha_bridge/BridgeController.cpp b/src/ha_bridge/BridgeController.cpp
new file mode 100755
index 00000000..119b0c57
--- /dev/null
+++ b/src/ha_bridge/BridgeController.cpp
@@ -0,0 +1,180 @@
+#include "BridgeController.h"
+#include <cstring>
+
+namespace Pinetime {
+namespace Applications {
+namespace HaBridge {
+
+BridgeController::BridgeController() {
+  // Create BLE service
+  bleService_ = std::make_unique<Pinetime::Components::HomeAssistantService>(
+    [this](const std::vector<uint8_t>& data) {
+      OnBleDataReceived(data);
+    }
+  );
+
+  // Create UI app
+  app_ = std::make_unique<HomeAssistantApp>();
+
+  // Wire UI action callback
+  app_->SetActionInvokeCallback(
+    [this](uint8_t actionId, const char* gesture) {
+      OnUIActionInvoked(actionId, gesture);
+    }
+  );
+
+  // Wire frame codec callback
+  frameCodec_.SetOnFrameReceived(
+    [this](const Frame& frame) {
+      OnFrameReceived(frame);
+    }
+  );
+}
+
+BridgeController::~BridgeController() {
+}
+
+void BridgeController::Init() {
+  // Initialize BLE service
+  bleService_->Init();
+
+  // Initialize UI app
+  app_->Init();
+}
+
+void BridgeController::OnTick() {
+  // Check for frame reassembly timeouts
+  frameCodec_.CheckTimeout();
+
+  // UI tick
+  app_->OnTick();
+}
+
+void BridgeController::OnBleDataReceived(const std::vector<uint8_t>& data) {
+  // Feed data to frame codec for reassembly
+  frameCodec_.OnBytesReceived(data);
+}
+
+void BridgeController::OnFrameReceived(const Frame& frame) {
+  // Dispatch based on message type
+  switch (frame.header.type) {
+    case static_cast<uint8_t>(MessageType::CONFIG_PUSH):
+      HandleConfigPush(frame.payload);
+      break;
+
+    case static_cast<uint8_t>(MessageType::STATE_UPDATE):
+      HandleStateUpdate(frame.payload);
+      break;
+
+    case static_cast<uint8_t>(MessageType::NOTIF_PUSH):
+      HandleNotifPush(frame.payload);
+      break;
+
+    default:
+      // Unknown message type - ignore
+      break;
+  }
+}
+
+void BridgeController::HandleConfigPush(const std::vector<uint8_t>& payload) {
+  ConfigPushMessage msg;
+  if (!ConfigPushMessage::DecodeCbor(payload.data(), payload.size(), msg)) {
+    // Decode failed
+    return;
+  }
+
+  // Convert protocol messages to UI model
+  std::vector<HaAction> actions;
+  for (const auto& protoAction : msg.actions) {
+    HaAction action;
+    action.id = protoAction.actionId;
+    action.label = protoAction.label;
+    action.confirm = false; // Can be extended in protocol if needed
+    actions.push_back(action);
+  }
+
+  std::vector<HaEntity> entities;
+  for (const auto& protoEntity : msg.entities) {
+    HaEntity entity;
+    entity.entityId = protoEntity.entityId;
+    entity.name = protoEntity.name;
+    entity.state = protoEntity.state;
+    entity.unit = protoEntity.unit;
+    entities.push_back(entity);
+  }
+
+  // Update UI
+  app_->SetActions(actions);
+  app_->SetEntities(entities);
+}
+
+void BridgeController::HandleStateUpdate(const std::vector<uint8_t>& payload) {
+  StateUpdateMessage msg;
+  if (!StateUpdateMessage::DecodeCbor(payload.data(), payload.size(), msg)) {
+    return;
+  }
+
+  // Convert to UI model
+  std::vector<HaEntity> entities;
+  for (const auto& protoEntity : msg.entities) {
+    HaEntity entity;
+    entity.entityId = protoEntity.entityId;
+    entity.name = protoEntity.name;
+    entity.state = protoEntity.state;
+    entity.unit = protoEntity.unit;
+    entities.push_back(entity);
+  }
+
+  // Update UI (partial update)
+  app_->SetEntities(entities);
+}
+
+void BridgeController::HandleNotifPush(const std::vector<uint8_t>& payload) {
+  NotifPushMessage msg;
+  if (!NotifPushMessage::DecodeCbor(payload.data(), payload.size(), msg)) {
+    return;
+  }
+
+  // Convert to UI model
+  HaNotification notif;
+  notif.title = msg.notification.title;
+  notif.body = msg.notification.body;
+  notif.tag = msg.notification.tag;
+  notif.severity = "info"; // Can be extended in protocol
+
+  // Push to UI
+  app_->PushNotification(notif, msg.deduplicate);
+}
+
+void BridgeController::OnUIActionInvoked(uint8_t actionId, const char* gesture) {
+  // Create ACTION_INVOKE message
+  ActionInvokeMessage msg;
+  msg.actionId = actionId;
+  msg.gesture = gesture;
+
+  // Encode to CBOR
+  std::vector<uint8_t> payload;
+  if (!msg.EncodeCbor(payload)) {
+    return;
+  }
+
+  // Send via BLE
+  SendMessage(MessageType::ACTION_INVOKE, payload);
+}
+
+void BridgeController::SendMessage(MessageType type, const std::vector<uint8_t>& payload) {
+  // Encode into frames
+  std::vector<std::vector<uint8_t>> chunks = frameCodec_.EncodeMessage(
+    static_cast<uint8_t>(type),
+    payload
+  );
+
+  // Send each chunk via BLE
+  for (const auto& chunk : chunks) {
+    bleService_->SendNotify(chunk);
+  }
+}
+
+} // namespace HaBridge
+} // namespace Applications
+} // namespace Pinetime
diff --git a/src/ha_bridge/BridgeController.h b/src/ha_bridge/BridgeController.h
new file mode 100755
