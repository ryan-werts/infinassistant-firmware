+// Message types from PROTOCOL.md
+enum class MessageType : uint8_t {
+  CONFIG_PUSH = 0x01,
+  ACTION_INVOKE = 0x02,
+  STATE_UPDATE = 0x03,
+  NOTIF_PUSH = 0x04,
+};
+
+// Forward declarations for CBOR integration
+class CborEncoder;
+class CborDecoder;
+
+// Base message interface
+struct ProtocolMessage {
+  virtual ~ProtocolMessage() = default;
+  virtual MessageType GetType() const = 0;
+  virtual bool EncodeCbor(std::vector<uint8_t>& output) const = 0;
+};
+
+// Action definition (part of CONFIG_PUSH)
+struct HaAction {
+  uint8_t actionId;
+  std::string label;
+  std::string entityId;
+  std::string serviceAction;
+  std::vector<std::pair<std::string, std::string>> serviceData; // key-value pairs
+
+  bool EncodeCbor(std::vector<uint8_t>& output) const;
+  static bool DecodeCbor(const uint8_t* data, size_t len, HaAction& out);
+};
+
+// Entity definition (part of CONFIG_PUSH)
+struct HaEntity {
+  std::string entityId;
+  std::string name;
+  std::string state;
+  std::string unit;
+  uint8_t precision;
+  bool showUnits;
+  bool showIcon;
+
+  bool EncodeCbor(std::vector<uint8_t>& output) const;
+  static bool DecodeCbor(const uint8_t* data, size_t len, HaEntity& out);
+};
