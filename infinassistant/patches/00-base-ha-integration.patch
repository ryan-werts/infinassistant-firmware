diff --git a/src/components/ble/HomeAssistantService.cpp b/src/components/ble/HomeAssistantService.cpp
new file mode 100755
index 00000000..727f4a3b
--- /dev/null
+++ b/src/components/ble/HomeAssistantService.cpp
@@ -0,0 +1,64 @@
+#include "components/ble/HomeAssistantService.h"
+#include <host/ble_gatt.h>
+#include <os/os_mbuf.h>
+
+using namespace Pinetime::Controllers;
+
+int HomeAssistantCallback(uint16_t /*connHandle*/, uint16_t /*attrHandle*/, struct ble_gatt_access_ctxt* ctxt, void* arg) {
+  return static_cast<HomeAssistantService*>(arg)->OnCommand(ctxt);
+}
+
+HomeAssistantService::HomeAssistantService() {
+}
+
+void HomeAssistantService::Init() {
+  ble_gatts_count_cfg(serviceDefinition_);
+  ble_gatts_add_svcs(serviceDefinition_);
+}
+
+void HomeAssistantService::SetOnDataReceived(OnDataReceived callback) {
+  onDataReceived_ = std::move(callback);
+}
+
+int HomeAssistantService::OnCommand(struct ble_gatt_access_ctxt* ctxt) {
+  if (ctxt->op == BLE_GATT_ACCESS_OP_WRITE_CHR) {
+    size_t len = OS_MBUF_PKTLEN(ctxt->om);
+    if (len > 0 && onDataReceived_) {
+      std::vector<uint8_t> data(len);
+      os_mbuf_copydata(ctxt->om, 0, len, data.data());
+      onDataReceived_(data.data(), data.size());
+    }
+  }
+  return 0;
+}
+
+void HomeAssistantService::SendNotify(uint16_t connHandle, const uint8_t* data, size_t len) {
+  if (txHandle_ == 0 || connHandle == BLE_HS_CONN_HANDLE_NONE) {
+    return;
+  }
+
+  struct os_mbuf* om = ble_hs_mbuf_from_flat(data, len);
+  if (om) {
+    ble_gattc_notify_custom(connHandle, txHandle_, om);
+  }
+}
+
+void HomeAssistantService::SetActions(std::vector<Action> actions) {
+  actions_ = std::move(actions);
+  hasUpdate_ = true;
+}
+
+void HomeAssistantService::SetEntities(std::vector<Entity> entities) {
+  entities_ = std::move(entities);
+  hasUpdate_ = true;
+}
+
+void HomeAssistantService::AddNotification(Notification notif) {
+  notifications_.push_back(std::move(notif));
+  hasUpdate_ = true;
+}
+
+void HomeAssistantService::ClearNotifications() {
+  notifications_.clear();
+  hasUpdate_ = true;
+}
diff --git a/src/components/ble/HomeAssistantService.h b/src/components/ble/HomeAssistantService.h
new file mode 100755
index 00000000..68b1a18a
--- /dev/null
+++ b/src/components/ble/HomeAssistantService.h
@@ -0,0 +1,129 @@
+#pragma once
+
+#include <cstdint>
+#include <vector>
+#include <functional>
+#include <array>
+#include <string>
+
+#define min
+#define max
+#include <host/ble_gap.h>
+#include <host/ble_uuid.h>
+#undef max
+#undef min
+
+int HomeAssistantCallback(uint16_t connHandle, uint16_t attrHandle, struct ble_gatt_access_ctxt* ctxt, void* arg);
+
+namespace Pinetime {
+namespace Controllers {
+
+class HomeAssistantService {
+public:
+  // Callback types
+  using OnDataReceived = std::function<void(const uint8_t* data, size_t len)>;
+
+  HomeAssistantService();
+  void Init();
+  void SetOnDataReceived(OnDataReceived callback);
+
+  // Called by NimBLE when data is written to RX characteristic
+  int OnCommand(struct ble_gatt_access_ctxt* ctxt);
+
+  // Send data to phone via TX (notify) characteristic
+  void SendNotify(uint16_t connHandle, const uint8_t* data, size_t len);
+
+  // Data model for UI
+  struct Action {
+    uint8_t id;
+    std::array<char, 32> label;
+    bool confirm;
+  };
+
+  struct Entity {
+    std::array<char, 64> entityId;
+    std::array<char, 32> name;
+    std::array<char, 32> state;
+    std::array<char, 8> unit;
+  };
+
+  struct Notification {
+    std::array<char, 32> title;
+    std::array<char, 128> body;
+    std::array<char, 16> severity;
+  };
+
+  // Accessors for current data
+  const std::vector<Action>& GetActions() const { return actions_; }
+  const std::vector<Entity>& GetEntities() const { return entities_; }
+  const std::vector<Notification>& GetNotifications() const { return notifications_; }
+
+  // Data setters (called by protocol handler)
+  void SetActions(std::vector<Action> actions);
+  void SetEntities(std::vector<Entity> entities);
+  void AddNotification(Notification notif);
+  void ClearNotifications();
+
+  // Check for updates
+  bool HasUpdate() const { return hasUpdate_; }
+  void ClearUpdate() { hasUpdate_ = false; }
+
+private:
+  // 00060000-78fc-48fe-8e23-433b3a1942d0
+  static constexpr ble_uuid128_t BaseUuid() {
+    return CharUuid(0x00, 0x00);
+  }
+
+  // 0006yyxx-78fc-48fe-8e23-433b3a1942d0
+  static constexpr ble_uuid128_t CharUuid(uint8_t x, uint8_t y) {
+    return ble_uuid128_t{
+      .u = {.type = BLE_UUID_TYPE_128},
+      .value = {0xd0, 0x42, 0x19, 0x3a, 0x3b, 0x43, 0x23, 0x8e, 0xfe, 0x48, 0xfc, 0x78, y, x, 0x06, 0x00}
+    };
+  }
+
+  ble_uuid128_t serviceUuid_{BaseUuid()};
+  ble_uuid128_t txCharUuid_{CharUuid(0x00, 0x01)};  // Notify (watch→phone)
+  ble_uuid128_t rxCharUuid_{CharUuid(0x00, 0x02)};  // Write (phone→watch)
+
+  struct ble_gatt_chr_def characteristicDefinition_[3] = {
+    {
+      .uuid = &txCharUuid_.u,
+      .access_cb = HomeAssistantCallback,
+      .arg = this,
+      .flags = BLE_GATT_CHR_F_NOTIFY,
+      .val_handle = &txHandle_
+    },
+    {
+      .uuid = &rxCharUuid_.u,
+      .access_cb = HomeAssistantCallback,
+      .arg = this,
+      .flags = BLE_GATT_CHR_F_WRITE | BLE_GATT_CHR_F_WRITE_NO_RSP,
+      .val_handle = &rxHandle_
+    },
+    {0}
+  };
+
+  struct ble_gatt_svc_def serviceDefinition_[2] = {
+    {
+      .type = BLE_GATT_SVC_TYPE_PRIMARY,
+      .uuid = &serviceUuid_.u,
+      .characteristics = characteristicDefinition_
+    },
+    {0}
+  };
+
+  uint16_t txHandle_{0};
+  uint16_t rxHandle_{0};
+
+  OnDataReceived onDataReceived_;
+
+  // Data storage
+  std::vector<Action> actions_;
+  std::vector<Entity> entities_;
+  std::vector<Notification> notifications_;
+  bool hasUpdate_{false};
+};
+
+} // namespace Controllers
+} // namespace Pinetime
