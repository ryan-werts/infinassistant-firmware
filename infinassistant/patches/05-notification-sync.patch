+NotificationManager::Notification::Id NotificationManager::Push(NotificationManager::Notification&& notif) {
+  const Notification::Id id = PushLocked(std::move(notif));
+  if (pushHook != nullptr) {
+    pushHook(hookContext);
+  }
+  return id;
+}
