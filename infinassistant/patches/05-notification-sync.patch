+namespace {
+  // The list is changed from the NimBLE host task (a push, a remove from the phone) and from the
+  // display task (the user's dismiss). Every access runs inside a short critical section: a push
+  // or a dismiss moves at most five 104-byte entries. Critical sections nest, so a method may call
+  // another one that takes it too.
+  struct ListLock {
+    ListLock() {
+      taskENTER_CRITICAL();
+    }
+    ~ListLock() {
+      taskEXIT_CRITICAL();
+    }
+  };
+}
