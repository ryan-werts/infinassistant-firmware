+void QuickSettings::UpdateBrightnessLabel() {
+  if (settingsController.GetBrightness() == Controllers::BrightnessController::Levels::Button) {
+    // The brightness icon with a B at its lower right. lv_font_sys_48 holds icons only, so the letter
+    // is a second label in a text font the build already links (declared for every screen by
+    // LV_FONT_CUSTOM_DECLARE in lv_conf.h). It is a child of the screen, not of the button, whose
+    // layout would stack it under the icon; a label is not clickable, so the button still gets the tap.
+    lv_obj_set_style_local_text_font(btn1_lvl, LV_LABEL_PART_MAIN, LV_STATE_DEFAULT, &lv_font_sys_48);
+    lv_label_set_text_static(btn1_lvl, Symbols::brightnessHigh);
+    if (btn1_b == nullptr) {
+      btn1_b = lv_label_create(lv_scr_act(), nullptr);
+      lv_obj_set_style_local_text_font(btn1_b, LV_LABEL_PART_MAIN, LV_STATE_DEFAULT, &jetbrains_mono_bold_20);
+      lv_label_set_text_static(btn1_b, "B");
+    }
+    lv_obj_align(btn1_b, btn1, LV_ALIGN_IN_BOTTOM_RIGHT, -10, -6);
+  } else {
+    if (btn1_b != nullptr) {
+      lv_obj_del(btn1_b);
+      btn1_b = nullptr;
+    }
+    lv_obj_set_style_local_text_font(btn1_lvl, LV_LABEL_PART_MAIN, LV_STATE_DEFAULT, &lv_font_sys_48);
+    lv_label_set_text_static(btn1_lvl, brightness.GetIcon());
+  }
+}
